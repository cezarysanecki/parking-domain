<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_initial_tables" author="cezarysanecki">
        <createTable tableName="parking_spot_catalogue">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="parking_spot_catalogue_primary_key_constraint"/>
            </column>
            <column name="capacity" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="client_catalogue">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="client_catalogue_primary_key_constraint"/>
            </column>
            <column name="type" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="phoneNumber" type="varchar(20)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
