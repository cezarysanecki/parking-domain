meta {
  name: View free time slots to request
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/requesting/view/free
  body: none
  auth: none
}

tests {
  if (res.body[0] != null) {
    var parkingSpotId = res.body[0].parkingSpotId;
    var from = res.body[0].from;
    var to = res.body[0].to;
    
    bru.setEnvVar("parkingSpotId", parkingSpotId);
    bru.setEnvVar("from", from);
    bru.setEnvVar("to", to);
  }
  
}
