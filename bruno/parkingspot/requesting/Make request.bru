meta {
  name: Make request
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/requesting/request
  body: json
  auth: none
}

body:json {
  {
    "requesterId": "{{clientId}}",
    "parkingSpotId": "{{parkingSpotId}}",
    "from": "{{from}}",
    "to": "{{to}}",
    "spotUnits": "2"
  }
}

tests {
  var requestId = res.body;
  
  bru.setEnvVar("requestId", requestId);
}
